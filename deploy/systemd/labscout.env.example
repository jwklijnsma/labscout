# labscout secrets (mode 600). Names match the *_token_env settings in labscout.yml.
LABSCOUT_WEB_TOKEN=change-me-openssl-rand-hex-24
OLLAMA_HOST=http://127.0.0.1:11434
# Read-only Proxmox API token secrets (PVEAuditor), one per endpoint in labscout.yml
PVE_TOKEN_HOME_CLUSTER=
# NetBox API token with write access to IPAM (only for `apply --netbox`)
NETBOX_TOKEN=
# NetAlertX API token (optional source of device names)
NETALERTX_API_TOKEN=
